def jogo_forca():
    palavra = random.choice(palavras)

    letras_descobertas = ["_"] * len(palavra)
    letras_erradas = []

    tentativas = 0
    max_tentativas = len(forca_desenho) - 1

    print("🎮 Bem-vindo ao Jogo da Forca!")
    print("Adivinhe a palavra antes que o boneco seja enforcado!\n")

    while tentativas < max_tentativas:

        print(forca_desenho[tentativas])
        print("Palavra:", " ".join(letras_descobertas))
        print("Letras erradas:", " ".join(letras_erradas))

        chute = input("\nDigite uma letra: ").lower()

        # Verifica se foi digitada apenas uma letra
        if not chute.isalpha() or len(chute) != 1:
            print("⚠️ Digite apenas uma letra!")
            continue

        # Verifica se a letra já foi usada
        if chute in letras_descobertas or chute in letras_erradas:
            print("⚠️ Você já tentou essa letra!")
            continue

        # Se a letra estiver na palavra
        if chute in palavra:

            for i, letra in enumerate(palavra):
                if letra == chute:
                    letras_descobertas[i] = chute

            print("✅ Boa! A letra está na palavra!")

            # Verifica se ganhou
            if "_" not in letras_descobertas:
                print("\n🎉 PARABÉNS! VOCÊ VENCEU!")
                print("A palavra era:", palavra.upper())
                break

        # Se a letra estiver errada
        else:
            letras_erradas.append(chute)
            tentativas += 1
            print("❌ Essa letra não está na palavra!")

    else:
        print(forca_desenho[tentativas])
        print("\n💀 VOCÊ PERDEU!")
        print("A palavra era:", palavra.upper())


if __name__ == "__main__":
    jogo_forca()